DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chistodom?schema=public"
ADMIN_PASSWORD_HASH=""
SESSION_SECRET="replace-with-at-least-32-random-bytes"
APP_URL="http://localhost:3000"
UPLOAD_DIR="./uploads"
# Optional initial company identity
# Optional local-only password fallback; production must use ADMIN_PASSWORD_HASH.
# DEV_ADMIN_PASSWORD="local-demo-password"

# Private S3-compatible storage (required in production; leave empty for local disk in development)
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Shared serverless rate limiting (required in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
